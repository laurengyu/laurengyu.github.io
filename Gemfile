source "https://rubygems.org"

# Matches the exact Jekyll + plugin versions GitHub Pages builds with.
gem "github-pages", group: :jekyll_plugins

# Ruby 3+ no longer bundles webrick, which `jekyll serve` needs.
gem "webrick", "~> 1.8"

# Removed from Ruby's default gems in 3.4+, but Jekyll 3 still requires them.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
